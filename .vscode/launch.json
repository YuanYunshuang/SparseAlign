    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cosense3d/tools/agent_runner.py",
            "console": "integratedTerminal",
            "args": ["--config", "./cosense3d/config/sparse_align/opv2v.yaml",
             "--mode", "train", "--run-name", "sa-opv2v"],
             "justMyCode": false,
             "env": {
                 "PYTHONPATH": "${workspaceFolder}",
                 "QT_QPA_PLATFORM": "offscreen"
             }
        },
    ]
}